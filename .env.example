DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Comma-separated emails that get admin powers (delete hatches, review
# hatcher applications, message inboxes) after signing up with that email.
# Emails are NOT verified — admin belongs to whoever registers the address
# first, so sign up with your admin email before exposing the server.
HATCH_ADMIN_EMAILS=admin@example.com

# Free-tier alternative: get a free key at https://console.groq.com/keys,
# set it below, and also set AI_PROVIDER=groq (needed if a DEEPSEEK_API_KEY
# is also present above, since that one is preferred by default).
# GROQ_API_KEY=your_groq_api_key_here
# AI_PROVIDER=groq
